+bool nvme_identify_active_namespaces(void *buffer)
+{
+    struct nvme_command cmd;
+    u64 buffer_addr = (u64)buffer;
+
+    if (!nvme_initialized || (buffer_addr & (SZ_4K - 1)))
+        return false;
+
+    memset(&cmd, 0, sizeof(cmd));
+    cmd.opcode = NVME_ADMIN_CMD_IDENTIFY;
+    cmd.prp1 = buffer_addr;
+    cmd.cdw10 = 2; /* CNS: active namespace ID list */
+
+    return nvme_exec_command(&adminq, &cmd, NULL);
+}
