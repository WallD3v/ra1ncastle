+bool nvme_allow_dma_region(void *buffer, size_t size)
+{
+    if (!nvme_initialized || !nvme_sart)
+        return false;
+
+    printf("nvme: allowing DMA region %p size 0x%lx through SART\n", buffer, size);
+    return sart_add_allowed_region(nvme_sart, buffer, size);
