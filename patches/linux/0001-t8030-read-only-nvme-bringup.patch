+static blk_status_t apple_nvme_sart_map_request(struct apple_nvme *anv,
+						 struct request *req)
+{
+	struct apple_nvme_iod *iod = blk_mq_rq_to_pdu(req);
+	phys_addr_t start, end, prp_start, prp_end;
+
+	if (!anv->hw->sart_map_all_dma)
+		return BLK_STS_OK;
+
+	/* The conservative T8030 bring-up path only permits one DMA segment. */
+	if (!iod->sart_data_len)
+		return BLK_STS_RESOURCE;
+
+	start = ALIGN_DOWN(iod->sart_data_dma, SZ_4K);
+	end = ALIGN(iod->sart_data_dma + iod->sart_data_len, SZ_4K);
+	if (apple_sart_add_allowed_region(anv->sart, start, end - start))
+		return BLK_STS_RESOURCE;
+
+	iod->sart_paddr = start;
+	iod->sart_size = end - start;
+
+	/*
+	 * A 16 KiB transfer can need a small PRP list when it crosses more
+	 * than two 4 KiB controller pages.  max_hw_sectors is capped at one
+	 * Linux page for T8030, so the 256-byte pool is the only list format
+	 * reachable here.  Map that list separately through SART.
+	 */
+	if (iod->npages >= 0) {
+		if (iod->npages != 0)
+			goto out_remove_data;
+		prp_start = ALIGN_DOWN(iod->first_dma, SZ_4K);
+		prp_end = ALIGN(iod->first_dma + 256, SZ_4K);
+		if (apple_sart_add_allowed_region(anv->sart, prp_start,
+						  prp_end - prp_start))
+			goto out_remove_data;
+		iod->sart_prp_paddr = prp_start;
+		iod->sart_prp_size = prp_end - prp_start;
+	}
+
+	dev_emerg(anv->dev,
+		  "T8030 SART payload paddr=%pa size=0x%zx dma=%pad len=0x%x prp-size=0x%zx\n",
+		  &start, (size_t)(end - start), &iod->sart_data_dma,
+		  iod->sart_data_len, iod->sart_prp_size);
+	return BLK_STS_OK;
+
+out_remove_data:
+	apple_sart_remove_allowed_region(anv->sart, iod->sart_paddr,
+					 iod->sart_size);
+	iod->sart_size = 0;
+	return BLK_STS_RESOURCE;
+}
