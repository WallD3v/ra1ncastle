+/*
+ * T8030 combines the CoastGuard/NVMMU TCBs introduced on newer chips with
+ * ordinary circular NVMe submission queues and standard tail doorbells.
+ */
+static void apple_nvme_submit_cmd_t8030(struct apple_nvme_queue *q,
+					struct nvme_command *cmd)
+{
+	struct apple_nvme *anv = queue_to_apple_nvme(q);
+	struct nvme_command queue_cmd = *cmd;
+	u16 original_cid = le16_to_cpu(cmd->common.command_id);
+	u16 slot = q->sq_tail;
+	u32 tag = slot;
+	struct apple_nvmmu_tcb *tcb;
+
+	/* A13 CoastGuard requires the wire CID and TCB index to match the SQ slot. */
+	queue_cmd.common.command_id = cpu_to_le16(slot);
+	q->slot_to_cid[slot] = original_cid;
+	apple_nvme_setup_tcb(q, &queue_cmd);
+	tcb = &q->tcbs[tag];
+	apple_nvme_submit_cmd_t8015(q, &queue_cmd);
+
+	dev_emerg(anv->dev,
+		  "T8030 submit aq=%u op=0x%x host-cid=%u wire-cid=%u slot=%u tail=%u flags=0x%x prp1=0x%llx prp2=0x%llx\n",
+		  q->is_adminq, cmd->common.opcode,
+		  original_cid, tag, slot, q->sq_tail,
+		  tcb->dma_flags, le64_to_cpu(tcb->prp1),
+		  le64_to_cpu(tcb->prp2));
+
+	/*
+	 * m1n1 can operate this controller by polling the completion queue,
+	 * while the A13 interrupt routing is still under investigation. Keep
+	 * the normal IRQ path and arm a bounded CQ poller after each command.
+	 */
+	WRITE_ONCE(anv->poll_deadline, jiffies + msecs_to_jiffies(5000));
+	mod_delayed_work(system_wq, &anv->poll_work, msecs_to_jiffies(1));
+}
