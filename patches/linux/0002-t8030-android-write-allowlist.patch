+static bool apple_nvme_write_allowed(struct apple_nvme *anv,
+				     struct nvme_ns *ns,
+				     const struct nvme_rw_command *rw)
+{
+	u64 first = le64_to_cpu(rw->slba);
+	u64 last = first + le16_to_cpu(rw->length);
+	u32 i;
+
+	if (ns->head->ns_id != anv->write_allow_nsid || last < first)
+		return false;
+
+	for (i = 0; i < anv->write_allow_nranges; i++) {
+		const struct apple_nvme_lba_range *range =
+			&anv->write_allow_ranges[i];
+
+		if (first >= range->first && last <= range->last)
+			return true;
+	}
+
+	return false;
+}
+
+static bool apple_nvme_io_allowed(struct apple_nvme *anv,
+				  struct nvme_ns *ns,
+				  const struct nvme_command *cmd)
+{
+	switch (cmd->common.opcode) {
+	case nvme_cmd_read:
+		return true;
+	case nvme_cmd_write:
+		return apple_nvme_write_allowed(anv, ns, &cmd->rw);
+	case nvme_cmd_flush:
+		return ns->head->ns_id == anv->write_allow_nsid;
+	default:
+		return false;
+	}
+}
