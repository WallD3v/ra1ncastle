+static int apple_nvme_parse_write_allowlist(struct apple_nvme *anv)
+{
+	struct device_node *np = anv->dev->of_node;
+	u64 ranges[APPLE_NVME_MAX_WRITE_RANGES * 2];
+	int nranges, i, ret;
+
+	nranges = of_property_count_elems_of_size(np,
+			"ra1ncastle,write-allow-lba-ranges", sizeof(u64));
+	if (nranges == -EINVAL &&
+	    !of_find_property(np, "ra1ncastle,write-allow-nsid", NULL))
+		return 0;
+	if (nranges < 0 || !nranges || nranges % 2 ||
+	    nranges > ARRAY_SIZE(ranges))
+		return dev_err_probe(anv->dev, -EINVAL,
+			"invalid ra1ncastle write allowlist ranges\n");
+
+	ret = of_property_read_u32(np, "ra1ncastle,write-allow-nsid",
+				   &anv->write_allow_nsid);
+	if (ret || !anv->write_allow_nsid)
+		return dev_err_probe(anv->dev, -EINVAL,
+			"invalid ra1ncastle write allowlist namespace\n");
+
+	ret = of_property_read_u64_array(np,
+		"ra1ncastle,write-allow-lba-ranges", ranges, nranges);
+	if (ret)
+		return dev_err_probe(anv->dev, ret,
+			"failed to read ra1ncastle write allowlist\n");
+
+	for (i = 0; i < nranges / 2; i++) {
+		if (ranges[i * 2] > ranges[i * 2 + 1])
+			return dev_err_probe(anv->dev, -EINVAL,
+				"invalid ra1ncastle write LBA range\n");
+		anv->write_allow_ranges[i].first = ranges[i * 2];
+		anv->write_allow_ranges[i].last = ranges[i * 2 + 1];
+	}
+	anv->write_allow_nranges = nranges / 2;
+	return 0;
+}
