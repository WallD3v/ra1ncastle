diff --git a/BoardConfig.mk b/BoardConfig.mk
index 95be2e4..4ad52ef 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -118,6 +118,18 @@ BOOT_KERNEL_MODULES :=
 RECOVERY_KERNEL_MODULES :=
 TARGET_AUTO_COLLECT_KERNEL_MODULE_DEPS := true
 
+# The RAM-only Recovery product keeps NVMe unloaded. A full Android System
+# build uses the same validated modules, but loads them from vendor ramdisk
+# before first-stage init mounts system/vendor from the internal NVMe disk.
+ifneq ($(SNOWCASTLE_RAMONLY_RECOVERY),true)
+SNOWCASTLE_NVME_MODULES := nvme-core.ko nvme-apple.ko
+BOOT_KERNEL_MODULES += $(SNOWCASTLE_NVME_MODULES)
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES := \
+    $(addprefix $(SNOWCASTLE_RAMONLY_KERNEL_DIR)/,$(SNOWCASTLE_NVME_MODULES))
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD := $(SNOWCASTLE_NVME_MODULES)
+BOARD_VENDOR_KERNEL_MODULES_LOAD := $(SNOWCASTLE_NVME_MODULES)
+endif
+
 # The external APFS-RW module is only needed for the APFS image scheme.
 # Do not require or load it for normal partitions or RAM-only recovery.
 ifeq ($(SNOWCASTLE_PARTITION_SCHEME),apfs)
