# Core boot/debug requirements
CONFIG_ARM64_16K_PAGES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# Preserve the framebuffer inherited from iBoot/m1n1.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# T8030 Lightning peripheral-mode USB gadget path.
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_DUAL_ROLE is not set
CONFIG_USB_DWC3_APPLE=y
CONFIG_PHY_APPLE_AUSB=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_NCM=y

# Do not expose any storage-oriented USB function.
# CONFIG_USB_F_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_G_MULTI is not set
# CONFIG_USB_GADGETFS is not set

# T8030 storage discovery milestone. The driver-specific T8030 quirk rejects
# every non-read I/O command; the initramfs does not mount internal storage.
# Keep both NVMe pieces modular: the initramfs brings USB diagnostics online
# first, then explicitly loads nvme-core followed by the experimental Apple
# transport.  The packaging and verification scripts ship both .ko files.
CONFIG_NVME_CORE=m
# Keep the experimental T8030 driver out of the synchronous boot path.  The
# initramfs brings USB diagnostics up first and the host loads this module only
# after a live dmesg connection has been established.
CONFIG_NVME_APPLE=m

# USB Ethernet shell fallback.
CONFIG_NET=y
CONFIG_INET=y
