# Reproducible source pins verified on 2026-09-29.

USBLITER8_URL=https://github.com/JoshAtticus/usbliter8.git
USBLITER8_REV=479dbbf4ad80e4a454e0779d1b4d1ec5eb0d7bd5

# A13 support is in Yuriy Havrylyuk's fork, not HoolockLinux/m1n1:idevice.
M1N1_URL=https://github.com/yhavry/m1n1.git
M1N1_REV=f54f602220101dffaa500ddf2ca3d708243c8b73

# This is the documented pre-NVMe T8030 snapshot. It already contains
# t8030-n104.dts, DWC3 peripheral support and simple-framebuffer handoff.
LINUX_URL=https://github.com/yhavry/Hoolock-linux.git
LINUX_REV=38e339f66253b40b046ef84bd910426eba12f822

# A12/A13 post-pwned raw-iBoot flow.
REMOTE_BOOT_URL=https://github.com/yhavry/remote_boot.git
REMOTE_BOOT_REV=e9c6b2efcd737869fcc7c0f31ce087c0ad4e259b

HOOLOCK_DOCS_URL=https://github.com/yhavry/Hoolock-Docs-A13.git
HOOLOCK_DOCS_REV=96a110bc680f085f5744bb97679abbf41e2f0df5

# Upstream LineageOS Apple-device tree used as ra1ncastle's Android baseline.
# lineage-24.0 contains the newer
# generic-init and post-iPhone-X recovery display work needed by n104ap.
SNOWCASTLE_URL=https://github.com/LineageOS/android_device_apple_snowcastle.git
SNOWCASTLE_BRANCH=lineage-24.0
SNOWCASTLE_REV=4004579eaaf4b2e81fbfb5806d701f1d2ae8dab2

BUSYBOX_VERSION=1.37.0
BUSYBOX_SHA256=3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4

# Known-public, unencrypted PAC-era iBoot used by the A13 remote_boot fork.
# Keep configurable because host/device observations may require another build.
DEFAULT_IBOOT_BUILD=22A3354

# remote_boot requires ipsw >= 3.1.719 for correct LZSS IMG4 creation.
IPSW_VERSION=3.1.728
