# Copy to config/local.env only after recording the physical test setup.
RP2350_BOARD=
UBUNTU_VERSION=
HOST_ARCH=
IOS_VERSION=
SPARE_IPHONE_AVAILABLE=
BACKUP_STATUS=

# Leave this at the known-public remote_boot default unless deliberately tested.
A12A13_IBOOT_BUILD=22A3354

# Set to YES only after reviewing docs/safety.md.
I_ACCEPT_RAM_ONLY=NO

# Required only for explicitly selected internal-storage probe/write phases.
I_ACCEPT_INTERNAL_STORAGE_RISK=NO

# Required in addition to I_ACCEPT_INTERNAL_STORAGE_RISK for the separate,
# range-limited Android-write profile. The default payload remains read-only.
I_ACCEPT_ANDROID_WRITE_PROFILE=NO
